OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini,openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=http://127.0.0.1:8000
OPENROUTER_APP_TITLE=Mindly Memory Agent
APP_NAME=Mindly Memory Agent
LOG_LEVEL=INFO
USE_FAKE_LLM=false
CHAT_HISTORY_BACKEND=memory
CHAT_HISTORY_MAX_MESSAGES=0
DATABASE_URL=postgresql://mindly:mindly@127.0.0.1:5432/mindly
MEMORY_BACKEND=fact
MEMPALACE_PATH=data/mempalace
MEMPALACE_COLLECTION=mindly_memory_facts
FACT_EXTRACTOR=llm